{
  "manifest_version": 3,
  "name": "网页视频截图",
  "version": "1.3.0",
  "description": "截取哔哩哔哩或抖音当前视频、图文画面，不打断视频播放。",
  "permissions": ["activeTab", "downloads", "offscreen"],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://www.douyin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "截取当前视频或图文"
  },
  "commands": {
    "pause-and-capture": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "截取当前视频或图文画面"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://www.douyin.com/*"
      ],
      "js": ["utils.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
